else:
    st.info("O assistente de IA está pronto! Faça uma pergunta sobre os resultados do modelo.")

    prompt_usuario = st.text_area(
        "Faça uma pergunta sobre os resultados do modelo ou sobre a base:",
        "Ex: 'O modelo de treino foi bom?' ou 'Qual o TIPO_UNIDADE mais comum após o preenchimento?'"
    )

    enviar_pergunta = st.button("Enviar Pergunta à IA")

    if enviar_pergunta and prompt_usuario.strip() != "":
        try:
            with st.spinner("A IA está a pensar..."):
                client = Groq(api_key=groq_api_key)
                
                modelo_a_usar = "meta-llama/llama-4-maverick-17b-128e-instruct" 

                sintomas_features = [
                    'FEBRE', 'MIALGIA', 'CEFALEIA', 'EXANTEMA', 'VOMITO', 'NAUSEA', 
                    'DOR_COSTAS', 'CONJUNTVIT', 'ARTRITE', 'ARTRALGIA', 'PETEQUIA_N', 
                    'LEUCOPENIA', 'LACO', 'DOR_RETRO'
                ]

                # --- PROMPT ATUALIZADO PARA REFLETIR O PREENCHIMENTO ---
                prompt_completo = f"""
Aja como um cientista de dados especialista e amigável.

Contexto:
