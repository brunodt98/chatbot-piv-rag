# Copie este arquivo para ".env" e preencha com sua chave.
# Nunca faça commit do arquivo ".env" real (ele contém segredos).

# Obrigatório — chave da API da OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Opcionais (valores padrão já definidos em rag_core.py)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL=openai/gpt-oss-20b
TEMPERATURE=0.5

# Preços de referência (USD por 1 milhão de tokens) usados apenas para
# estimar custo nos relatórios/UI. Valores abaixo = preço do openai/gpt-oss-20b
# na OpenRouter em 11/09/2026 (https://openrouter.ai/openai/gpt-oss-20b/pricing).
# Ajuste se trocar de modelo.
PRECO_USD_POR_MILHAO_INPUT=0.02
PRECO_USD_POR_MILHAO_OUTPUT=0.10
